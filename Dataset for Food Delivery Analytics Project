"""
Generates the synthetic dataset 08_food_delivery.csv (fixed seed => reproducible).
The data is FICTIONAL and created only for this assignment. It deliberately contains
realistic data-quality issues so every task (missing values, duplicates, outliers) has
something meaningful to find.
"""
import numpy as np
import pandas as pd

rng = np.random.default_rng(2026)
N = 6000  # unique orders before duplicates are injected

cities = ["Delhi", "Mumbai", "Bengaluru", "Hyderabad", "Chennai", "Kolkata", "Pune", "Ahmedabad"]
city_w = [0.19, 0.19, 0.17, 0.12, 0.09, 0.09, 0.08, 0.07]
# operational "difficulty" per city: extra minutes, and cancellation probability
city_extra = {"Delhi": 6, "Mumbai": 8, "Bengaluru": 7, "Hyderabad": 2, "Chennai": 1,
              "Kolkata": 4, "Pune": 0, "Ahmedabad": -1}
city_cancel = {"Delhi": 0.09, "Mumbai": 0.10, "Bengaluru": 0.11, "Hyderabad": 0.06,
               "Chennai": 0.05, "Kolkata": 0.08, "Pune": 0.04, "Ahmedabad": 0.04}

restaurants = {  # name: (cuisine, average order value in INR)
    "Spice Route": ("North Indian", 520), "Biryani Junction": ("Biryani", 430),
    "Pizza Piazza": ("Italian", 610), "Burger Barn": ("Fast Food", 340),
    "Dosa Delight": ("South Indian", 260), "Wok & Roll": ("Chinese", 480),
    "Tandoori Tales": ("North Indian", 560), "Green Bowl": ("Healthy", 390),
    "Sweet Tooth": ("Desserts", 300), "Kebab Kingdom": ("Mughlai", 640),
    "Sushi Zen": ("Japanese", 880), "Thali House": ("Indian Thali", 310),
    "Taco Fiesta": ("Mexican", 420), "Momo Magic": ("Tibetan", 240),
    "Curry Leaf": ("South Indian", 350), "Grill Masters": ("BBQ", 720),
    "Roll Express": ("Fast Food", 220), "Chai & Chaat": ("Street Food", 180),
    "Pasta Palace": ("Italian", 540), "The Royal Feast": ("Mughlai", 910),
}
r_names = list(restaurants)
r_w = rng.dirichlet(np.ones(len(r_names)) * 4)

payments = ["UPI", "Credit Card", "Debit Card", "Cash on Delivery", "Wallet"]
pay_w = [0.46, 0.18, 0.12, 0.17, 0.07]

# order timestamps over 90 days, hours weighted to lunch (12-14) and dinner (19-22)
hour_w = np.array([1, 0.5, 0.3, 0.2, 0.2, 0.4, 1, 2, 3, 3, 3.5, 6, 10, 9, 5, 3.5, 3.5, 4.5,
                   7, 11, 12, 10, 6, 2.5], dtype=float)
hour_w /= hour_w.sum()
days = rng.integers(0, 90, N)
hours = rng.choice(24, N, p=hour_w)
mins = rng.integers(0, 60, N)
secs = rng.integers(0, 60, N)
order_dt = pd.Timestamp("2026-08-01") + pd.to_timedelta(days, "D") + pd.to_timedelta(hours, "h") \
    + pd.to_timedelta(mins, "m") + pd.to_timedelta(secs, "s")

city = rng.choice(cities, N, p=city_w)
rest = rng.choice(r_names, N, p=r_w)
cuisine = np.array([restaurants[r][0] for r in rest])
base_val = np.array([restaurants[r][1] for r in rest], dtype=float)
value = np.round(base_val * rng.lognormal(0, 0.35, N) / 5) * 5
value = np.clip(value, 90, 4500)

distance = np.round(np.clip(rng.gamma(3.0, 1.5, N), 0.5, 18), 1)
pay = rng.choice(payments, N, p=pay_w)

# delivery time = prep + travel + peak-hour congestion + city effect + noise
peak = np.isin(hours, [12, 13, 19, 20, 21]).astype(float)
delivery = (10 + distance * 2.2 + peak * 6 + np.array([city_extra[c] for c in city])
            + rng.gamma(2.5, 2.6, N))
# a few extreme deliveries (rider breakdown, weather, wrong address ...)
extreme = rng.random(N) < 0.012
delivery = np.where(extreme, delivery + rng.uniform(40, 110, N), delivery)
delivery = np.round(delivery, 0)

cancel_p = np.array([city_cancel[c] for c in city]) + peak * 0.02
cancelled = rng.random(N) < cancel_p
status = np.where(cancelled, "Cancelled", np.where(delivery > 45, "Delayed", "Delivered"))

delivery = delivery.astype(float)
delivery[cancelled] = np.nan                                    # never delivered
random_missing = (~cancelled) & (rng.random(N) < 0.025)         # logging failures
delivery[random_missing] = np.nan

rating = np.where(status == "Delivered", rng.choice([3, 4, 5], N, p=[0.12, 0.38, 0.50]),
                  np.where(status == "Delayed", rng.choice([1, 2, 3, 4], N, p=[0.2, 0.35, 0.35, 0.1]), np.nan))

df = pd.DataFrame({
    "Order_ID": [f"ORD{100000 + i}" for i in range(N)],
    "Order_DateTime": order_dt, "City": city, "Restaurant": rest, "Cuisine": cuisine,
    "Order_Value": value, "Payment_Mode": pay, "Distance_km": distance,
    "Delivery_Time_min": delivery, "Order_Status": status, "Customer_Rating": rating,
})

# ---- inject data-quality issues ----
# 1) a few messy city labels (trailing space / different case)
idx = rng.choice(N, 40, replace=False)
df.loc[idx[:20], "City"] = df.loc[idx[:20], "City"] + " "
df.loc[idx[20:], "City"] = df.loc[idx[20:], "City"].str.upper()
# 2) exact duplicate rows (system double-logging)
dups = df.sample(45, random_state=1)
# 3) same Order_ID but conflicting content (corrected record re-logged)
conf = df.sample(6, random_state=2).copy()
conf["Order_Value"] = conf["Order_Value"] + 50
df = pd.concat([df, dups, conf], ignore_index=True).sample(frac=1, random_state=3).reset_index(drop=True)

df.to_csv("08_food_delivery.csv", index=False)
print(df.shape)
print(df.isna().sum())
print(df["Order_Status"].value_counts(normalize=True).round(3))
